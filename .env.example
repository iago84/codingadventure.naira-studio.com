# Plantilla de variables de entorno. Copiar a .env y rellenar.
# .env NUNCA se versiona; este fichero sí, y debe quedar sin secretos reales.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0

# --- Base de datos ----------------------------------------------------------
# Local: sqlite. Produccion: postgres via DATABASE_URL.
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Traduccion automatica --------------------------------------------------
# LibreTranslate propio en produccion; vacio degrada a MyMemory publico.
LIBRETRANSLATE_URL=
TRANSLATE_HTTP_TIMEOUT=10

# --- Correo -----------------------------------------------------------------
# En desarrollo la consola evita depender de un SMTP real.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost

# --- Cola de tareas ---------------------------------------------------------
# Con varios workers hace falta Redis. Vacio usa InMemoryChannelLayer.
REDIS_URL=

# --- CORS -------------------------------------------------------------------
# En produccion declarar origenes explicitos separados por coma.
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Registro ---------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# --- Nota -------------------------------------------------------------------
# CSP: si se define DJANGO_CSP_DEFAULT con una cadena vacia, el servidor NO
# emite la cabecera. Vacio significa "sin politica", no "usa el valor por
# defecto". Dejar la linea comentada salvo que haga falta limitarla.
# DJANGO_CSP_DEFAULT=default-src 'self'
